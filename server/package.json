{
  "name": "mediflow-server",
  "version": "1.0.0",
  "description": "MediFlow REST API – Node.js + Express + MongoDB Atlas",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:doctors": "node seeds/seedDoctors.js",
    "seed:doctors:clear": "node seeds/seedDoctors.js --clear",
    "seed:admin": "node seeds/seedAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cloudinary": "2.5.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-fileupload": "1.5.1",
    "express-validator": "7.2.1",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "validator": "13.12.0"
  },
  "devDependencies": {
    "nodemon": "3.1.9"
  }
}
